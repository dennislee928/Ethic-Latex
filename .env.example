# IBM Quantum Platform (Phase 3: CloudQuantumJudge)
# Get a free token at https://quantum.ibm.com/
# IMPORTANT: Never commit a real token. Revoke any exposed token immediately.
IBM_QUANTUM_TOKEN=your_ibm_quantum_token_here

# PostgreSQL Database (docker-compose)
# Generate a strong password: python -c "import secrets; print(secrets.token_hex(32))"
# VUL-009: No default provided; this MUST be set before running docker-compose.
POSTGRES_PASSWORD=generate_a_strong_password_here

# Redis Configuration
REDIS_PASSWORD=

# Jupyter Notebook Token (docker-compose)
# VUL-010: Jupyter requires a token for authentication.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JUPYTER_TOKEN=generate_a_strong_token_here

# ERH Security App
NEXT_PUBLIC_API_URL=http://localhost:8000
DATABASE_URL=postgresql://erh_user:your_postgres_password@localhost:5432/erh_database
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins (VUL-002)
# Comma-separated list of trusted frontend origins.
# Example: "http://localhost:3000,https://app.example.com"
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Real Data URLs (for CI/CD - optional)
# COMPAS_DATA_URL=https://your-storage.com/compas-scores-two-years.csv
