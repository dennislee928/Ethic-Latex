{
  "name": "erh-guardian-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker MCP server for ERH Guardian: value profiles + decision audit log on D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply erh-guardian --local",
    "db:migrate": "wrangler d1 migrations apply erh-guardian --remote"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "agents": "^0.3.6",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.40.0"
  },
  "overrides": {
    "proxy-addr": "^2.0.8",
    "undici": "^7.30.1",
    "fast-uri": "^3.1.9",
    "sharp": "^0.35.5",
    "body-parser": "^2.4.0"
  }
}
